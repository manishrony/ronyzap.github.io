[Unit]
Description=Cloudline temp-based fan scheduler (optional, decoupled from gpu-monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/gpu-monitor/cloudline/.env
ExecStart=/usr/bin/python3 /opt/gpu-monitor/cloudline/scheduler.py
Restart=on-failure
RestartSec=15
# Runs as root: it appends pdu_power events to /var/log/gpu_monitor_data.jsonl,
# which gpu_monitor.sh chmods back to 644 root-owned on every restart. Under
# DynamicUser that silently broke fan power metering after each gpu-monitor
# restart (seen 2026-10-26 on zappa1: "Permission denied" every poll).

[Install]
WantedBy=multi-user.target
